{
  "name": "anvil-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first tool-interface workbench for open models: compare raw, described and executable adapted tools against independently checked state.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server/index.js",
    "mcp": "node dist/mcp/workbench.js",
    "mcp:adapter": "node dist/mcp/adapterServer.js",
    "cli": "node dist/cli.js",
    "smoke:mcp": "tsx scripts/mcp-smoke.ts",
    "e2e": "node scripts/reset-e2e.mjs && playwright test",
    "check:sim": "tsx scripts/simulation-check.ts",
    "smoke:api": "tsx scripts/api-smoke.ts",
    "seal:eval2": "tsx scripts/seal-eval2.ts",
    "seal:check": "tsx scripts/seal-eval2.ts --check",
    "build:static": "tsx scripts/build-static.ts",
    "live": "tsx scripts/live-pilot.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "express": "^4.21.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^4.17.23",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "bin": {
    "anvil": "dist/cli.js"
  }
}
