# Anvil local configuration. Copy to .env only if you need overrides.
# .env is gitignored and is read at startup when present.
# Never commit real credentials.

ANVIL_PORT=4317
ANVIL_HOST=127.0.0.1
ANVIL_DATA_DIR=.anvil

# Live model for CLI/MCP experiments, or configure it in the workbench UI.
# The UI key lives in process memory only. Putting a key in this file is an
# explicit on-disk opt-in; use it only if you accept that tradeoff.
# ANVIL_MODEL_PROVIDER=ollama
# ANVIL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# ANVIL_MODEL=qwen2.5:7b
# ANVIL_MODEL_API_KEY=

# Run a local Ollama model separately. Anvil does not download or manage it.